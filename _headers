/*
  Prevent stale HTML/JavaScript from keeping an older broken frontend after deployment.
*/
/
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

/*.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache

/*.html
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Pragma: no-cache
